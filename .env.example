# Copie este arquivo para .env e preencha apenas os valores necessarios.
# Nunca versione o .env real.

# --- PostgreSQL ---
POSTGRES_DB=analyzer
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Aplicacao Spring Boot ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/analyzer
SPRING_DATASOURCE_USERNAME=analyzer
SPRING_DATASOURCE_PASSWORD=change-me
AGENT_URL=http://agent:8000
APP_PORT=8080

# --- Servico agente (Python) ---
AGENT_PORT=8000

# --- Modelo de IA (Spring AI - esqueleto; nenhuma chave e obrigatoria para subir) ---
AI_CHAT_MODEL=
AI_CHAT_API_KEY=
AI_CHAT_BASE_URL=

# --- Embeddings (RAG pgvector; sem chave o RAG fica desativado e a analise segue degradada) ---
AI_EMBEDDING_MODEL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=

# --- RAG ---
AI_RAG_ENABLED=true
AI_RAG_TOP_K=4
AI_RAG_SIMILARITY_THRESHOLD=0.7
AI_RAG_KNOWLEDGE_PATH=/repo/knowledge

# --- Tools (raiz do repositorio acessivel pelas tools; protege contra path traversal) ---
TOOLS_REPO_ROOT=/repo

# --- Contrato interno do agente (endpoints /api/agent/** da aplicacao) ---
APP_URL=http://app:8080
