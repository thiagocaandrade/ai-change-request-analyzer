# Copie este arquivo para .env e preencha apenas os valores necessarios.
# Nunca versione o .env real.

# --- PostgreSQL ---
POSTGRES_DB=analyzer
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Aplicacao Spring Boot ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/analyzer
SPRING_DATASOURCE_USERNAME=analyzer
SPRING_DATASOURCE_PASSWORD=change-me
AGENT_URL=http://agent:8000
APP_PORT=8080

# --- Servico agente (Python) ---
AGENT_PORT=8000

# --- Modelo de IA (configuracao oficial; nenhuma chave e obrigatoria para subir) ---
# AI_PROVIDER: provedor do modelo de chat. Unico valor suportado hoje: "openai".
#   Qualquer outro valor deixa a analise em modo degradado (marcada), sem erro.
AI_PROVIDER=openai
# AI_MODEL: identificador do modelo de chat (ex.: gpt-4o-mini). Vazio -> modo degradado.
AI_MODEL=
# AI_TEMPERATURE: temperatura do modelo (>= 0). Ausente ou invalida -> default do provedor.
AI_TEMPERATURE=
# AI_API_KEY: chave de API do modelo de chat. Sem chave, a analise segue degradada (marcada).
AI_API_KEY=
# AI_CHAT_BASE_URL: extensao opcional para endpoints OpenAI-compatibles (ex.: modelos locais).
AI_CHAT_BASE_URL=

# --- Embeddings (RAG pgvector; sem chave o RAG fica desativado e a analise segue degradada) ---
AI_EMBEDDING_MODEL=
AI_EMBEDDING_API_KEY=
# Demo local: servico `embeddings` do docker-compose (stub deterministico). Para provider real,
# informe o endpoint OpenAI-compativel (ex.: https://api.openai.com/v1).
AI_EMBEDDING_BASE_URL=

# --- RAG ---
AI_RAG_ENABLED=true
AI_RAG_TOP_K=4
AI_RAG_SIMILARITY_THRESHOLD=0.7
AI_RAG_KNOWLEDGE_PATH=/repo/knowledge

# --- Tools (raiz do repositorio acessivel pelas tools; protege contra path traversal) ---
TOOLS_REPO_ROOT=/repo

# --- Contrato interno do agente (endpoints /api/agent/** da aplicacao) ---
APP_URL=http://app:8080
